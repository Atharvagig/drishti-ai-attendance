# Database settings
# DB_BACKEND: 'mongodb' or 'sqlite' (auto-detected if MONGODB_URI is provided)
DB_BACKEND=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=drishti_attendance
# Local SQLite fallback path (used if MONGODB_URI is unset)
DB_PATH=data/attendance.db

# Flask settings
FLASK_ENV=production
FLASK_PORT=5000
SECRET_KEY=drishti-ai-secure-key-v2-change-in-prod
SESSION_TIMEOUT_MINUTES=60

# Presentation / Demo Settings
DEMO_MODE=true

# Camera Configuration
PREFERRED_CAMERA_INDEX=0
CAMERA_RESOLUTION=1280x720

# Analytics Settings
ANALYTICS_RETENTION_DAYS=90
