# Drishti AI - Environment Configuration

# Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=drishti-ai-secret-key-change-in-production

# Email Alert System (SMTP)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECEIVER_EMAIL=admin_email@gmail.com

# Camera & Recognition Settings
CAMERA_INDEX=0
COOLDOWN_SECONDS=30
MATCH_TOLERANCE=0.45
