# ==============================================================================
# Drishti AI — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the actual .env file or production credentials to Git.
# ==============================================================================

# ── Database Configuration ───────────────────────────────────────────────────
# Active database engine: 'mongodb' (cloud cluster) or 'sqlite' (local file)
# If MONGODB_URI is provided, the system automatically uses MongoDB Atlas.
DB_BACKEND=mongodb

# MongoDB Atlas cluster connection string (Required for cloud deployment)
# Format: mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_domain>.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name
DATABASE_NAME=drishti_attendance

# Local SQLite fallback file path (used if MONGODB_URI is unset or offline)
DB_PATH=data/attendance.db

# ── Application & Web Server Settings ─────────────────────────────────────────
# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Web server port (Render automatically injects $PORT in production)
FLASK_PORT=5000

# Secret key for cryptographically signing Flask session cookies
# Generate a strong random key in production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Web session expiration time in minutes
SESSION_TIMEOUT_MINUTES=60

# Enforce HTTPS-only Secure attribute on session cookies (auto-enabled on Render / FLASK_ENV=production)
SESSION_COOKIE_SECURE=false

# ── Security & Authentication ─────────────────────────────────────────────────
# Custom administrator password.
# IMPORTANT: In production mode (FLASK_ENV=production), setting a secure ADMIN_PASSWORD
# with at least 8 characters is STRICTLY ENFORCED. In development mode, falls back to 'admin123'.
ADMIN_PASSWORD=your_secure_admin_password_here

# ── Face Recognition & Biometric Engine ───────────────────────────────────────
# Euclidean distance threshold for dlib 128-D face embeddings (lower = stricter match)
# Recommended values: 0.40 (strict), 0.45 (balanced default), 0.50 (lenient)
MATCH_TOLERANCE=0.45

# Cooldown window (in seconds) preventing immediate duplicate attendance marking
COOLDOWN_SECONDS=10

# Run in headless mode without local GUI preview windows (recommended for Docker/servers)
HEADLESS=false

# ── Hardware Camera Configuration (Local DirectShow / MSMF) ───────────────────
# Default hardware webcam device index (0 = primary webcam, 1 = external USB webcam)
PREFERRED_CAMERA_INDEX=0

# Hardware camera resolution capture profile
CAMERA_RESOLUTION=1280x720

# ── Demo & Presentation Settings ──────────────────────────────────────────────
# Enables the /api/demo/seed endpoint for generating sample academic records during viva
DEMO_MODE=false

# Retention period for statistical analytics queries (in days)
ANALYTICS_RETENTION_DAYS=90
